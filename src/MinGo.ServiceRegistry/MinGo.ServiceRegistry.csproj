<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>MinGo.ServiceRegistry</PackageId>
    <AssemblyName>MinGo.ServiceRegistry</AssemblyName>
    <RootNamespace>MinGo.ServiceRegistry</RootNamespace>
    <Description>Meta package that installs the full MinGo Service Registry SDK (Abstractions, Client, AspNetCore, ServiceDiscovery).</Description>
    <IsPackable>true</IsPackable>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MinGo.ServiceRegistry.Abstractions\MinGo.ServiceRegistry.Abstractions.csproj" />
    <ProjectReference Include="..\MinGo.ServiceRegistry.Client\MinGo.ServiceRegistry.Client.csproj" />
    <ProjectReference Include="..\MinGo.ServiceRegistry.AspNetCore\MinGo.ServiceRegistry.AspNetCore.csproj" />
    <ProjectReference Include="..\MinGo.ServiceRegistry.ServiceDiscovery\MinGo.ServiceRegistry.ServiceDiscovery.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
